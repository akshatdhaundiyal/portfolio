generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Blog {
  id                 String    @id @default(cuid())
  slug               String    @unique
  title              String
  subtitle           String?
  category           String    @default("Applied ML")
  summary            String
  readTime           String    @default("5 min read")
  accentColor        String    @default("#6366f1")
  tags               String[]
  featured           Boolean   @default(false)
  content            String    @db.Text
  coverImage         String?
  status             String    @default("published") // "published" or "draft"
  mediumPostId       String?
  mediumUrl          String?
  mediumPublishedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([slug])
  @@index([status])
  @@index([category])
}

model Project {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  subtitle         String?
  category         String    @default("Enterprise AI & Systems")
  role             String?
  organization     String?
  period           String?
  accentColor      String    @default("#d94e34")
  metricValue      String?
  metricLabel      String?
  summary          String    @db.Text
  context          String?   @db.Text
  learntThat       String?   @db.Text
  architecture     String[]
  techStack        String[]
  tradeoffs        Json?
  artifactSkin     String    @default("boarding-pass") // "boarding-pass", "baggage-tag", "retro-crt", "garment-tag", "spiral-notebook"
  artifactMetadata Json?
  section          String    @default("recently-made") // "currently-cooking", "recently-made", "other-work"
  status           String    @default("Shipped") // "Active", "Shipped", "Open Source", "In Progress"
  displayOrder     Int       @default(0)
  featured         Boolean   @default(true)
  githubUrl        String?
  liveUrl          String?
  videoUrl         String?
  posterUrl        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([slug])
  @@index([section])
  @@index([displayOrder])
  @@index([featured])
}

model Experience {
  id           String    @id @default(cuid())
  company      String
  role         String
  location     String?
  period       String
  startDate    DateTime?
  endDate      DateTime?
  current      Boolean   @default(false)
  description  String?   @db.Text
  highlights   String[]
  skills       String[]
  displayOrder Int       @default(0)
  featured     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([displayOrder])
  @@index([featured])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String
  role         String   @default("admin") // "superadmin", "admin", "dev"
  badge        String   @default("MAINTAINER // AUTHOR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([username])
  @@index([role])
}

model Order {
  id               String   @id @default(cuid())
  orderId          String   @unique
  paymentId        String?  @unique
  productSlug      String
  productName      String
  amount           Int
  currency         String   @default("INR")
  status           String   @default("created")
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  fulfillmentToken String?
  receipt          String?
  notes            Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([productSlug])
  @@index([customerEmail])
}

